NODE_ENV=development

# API Server
API_HOST=127.0.0.1
API_PORT=4000

# Web App
WEB_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Supabase (optional — required only for cloud/web auth mode)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Supabase PostgreSQL — optional for local/desktop mode)
DATABASE_URL=

# Redis (optional — required only for cloud worker queue)
REDIS_URL=

# Storage
STORAGE_BUCKET=capzee-media

# Processing mode: "local" or "cloud"
CAPZEE_PROCESSING_MODE=local

# Upload limits
CAPZEE_MAX_UPLOAD_MB=500
CAPZEE_MAX_DURATION_SECONDS=1800

# Worker concurrency
CAPZEE_WORKER_CONCURRENCY=1

# Whisper model settings
# Models: tiny, base, small, medium, large-v2, large-v3
# Device: cpu, cuda, auto
# Compute type (cpu): int8, float32
# Compute type (cuda): float16, int8_float16
CAPZEE_WHISPER_MODEL=small
CAPZEE_WHISPER_DEVICE=cpu
CAPZEE_WHISPER_COMPUTE_TYPE=int8

# FFmpeg paths (leave empty to use system PATH)
CAPZEE_FFMPEG_PATH=
CAPZEE_FFPROBE_PATH=

# Temporary directory (leave empty for system default)
CAPZEE_TEMP_DIR=

# LLM provider for social captions
# Providers: mock, openai, anthropic, ollama, gemini
# mock: deterministic output for development/tests (no API key needed)
# ollama: local LLM, no cost (requires Ollama installed and running)
CAPZEE_LLM_PROVIDER=mock
CAPZEE_LLM_API_KEY=
CAPZEE_LLM_MODEL=

# Ollama (optional, used when CAPZEE_LLM_PROVIDER=ollama)
CAPZEE_OLLAMA_BASE_URL=http://localhost:11434
CAPZEE_OLLAMA_MODEL=llama3.2

# Groq API (Zero Local AI Models — 1-2s Whisper Speech-to-Text & LLaMA 3.3)
GROQ_API_KEY=

# OpenAI API (Official Whisper & GPT-4o)
OPENAI_API_KEY=
